
<footer class="footer">
    <div class="footer-container">
        <div class="footer-section">
            <h3 class="footer-title">{{nombreHotel}}</h3>
            <p class="footer-description">{{descripcionFooter}}</p>
        </div>

        {{#each seccionesFooter}}
            <div class="footer-section">
                <h4 class="footer-heading">{{titulo}}</h4>
                <ul class="footer-list">
                    {{#each elementos}}
                        <li>{{this}}</li>
                    {{/each}}
                </ul>
            </div>
        {{/each}}

        <div class="footer-section">
            <h4 class="footer-heading">Síguenos</h4>
            <div class="social-links">
                {{#each redesSociales}}
                    <a href="{{enlace}}" class="social-link {{clase}}">{{nombre}}</a>
                {{/each}}
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <p>{{copyright}}</p>
    </div>
</footer>