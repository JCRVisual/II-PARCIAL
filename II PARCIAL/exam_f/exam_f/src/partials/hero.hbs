<section id="inicio" class="hero" style="background-image: url('{{imagenHero}}');">
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1 class="hero-title">{{tituloHero}}</h1>
        <p class="hero-subtitle">{{subtituloHero}}</p>
        <p class="hero-description">{{descripcionHero}}</p>

        <div class="hero-buttons">
            <button class="btn btn-primary">{{botonExplorar}}</button>
            <button class="btn btn-secondary">{{botonVideo}}</button>
        </div>
    </div>
</section>